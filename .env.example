# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Optional secret for signing session tokens (auto-generated in-memory if unset).
JWT_SECRET=

# ADMIN_PASSCODE: Optional passcode to unlock the Admin Dashboard.
ADMIN_PASSCODE=
